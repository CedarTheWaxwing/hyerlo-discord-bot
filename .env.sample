APP_ID=your_app_id
DISCORD_TOKEN=your_bot_token
PUBLIC_KEY=your_public_key

# Discord user ID allowed to run /invite (Developer Mode → Copy User ID)
OWNER_USER_ID=your_discord_user_id

# Channel ID used when creating the server invite (right-click channel → Copy Channel ID)
INVITE_CHANNEL_ID=your_channel_id

# Hyerlo Control Center — read-only QA intake from Discord channels
CONTROL_CENTER_URL=https://your-control-center.example.com
# Caddy HTTP Basic Auth in front of the Control Center (preferred when both user and password are set)
CONTROL_CENTER_BASIC_USER=your_basic_auth_username
CONTROL_CENTER_BASIC_PASSWORD=your_basic_auth_password
# Bot API key (Bearer when Basic Auth is not configured; also sent as X-Bot-Api-Key when Basic is used)
CONTROL_CENTER_BOT_API_KEY=your_control_center_bot_api_key

# Optional: override channel lookup by name
# FEATURE_REQUESTS_CHANNEL_ID=your_channel_id
# REPORT_BUG_CHANNEL_ID=your_channel_id

# Set to false to skip backfilling ~100 recent messages on startup (dedupe_key makes re-posts safe)
# QA_BACKFILL_ON_STARTUP=true
